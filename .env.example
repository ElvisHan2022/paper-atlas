# Copy to .env and fill in. Never commit .env.
# Needed for the LLM judge, the evidence lens and the systematic review.
# Without it the app still ranks papers with the local models.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: raises the Semantic Scholar rate limit.
S2_API_KEY=
# Optional: raises the PubMed rate limit from 3 to 10 requests per second.
NCBI_API_KEY=
# Optional: your email, which puts OpenAlex requests in its faster "polite pool".
OPENALEX_EMAIL=
